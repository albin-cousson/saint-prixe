---
const email = 'aurelie.cousson68@gmail.com';
const phone = '06 70 91 05 26';
const phoneHref = '0670910526';
const addressLines = ["24 rue d'Issenheim", '68190 Raedersheim, France'];
const social = [
  { platform: 'Facebook', href: 'https://www.facebook.com/cousson.aurelie' },
  { platform: 'Instagram', href: 'https://www.instagram.com/aurelie_cousson/' },
];
const year = new Date().getFullYear();
---

<footer class="bg-ink text-cream mt-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16 grid gap-12 md:grid-cols-3">
    <div>
      <p class="font-display font-bold text-lg">DE SAINT PRIXE</p>
      <p class="text-xs tracking-[0.2em] text-gold mt-1">ÉLEVAGE DE BEARDED COLLIE</p>
    </div>

    <div class="text-sm text-cream/80 space-y-2">
      <a href={`tel:${phoneHref}`} class="block hover:text-gold transition-colors">{phone}</a>
      <a href={`mailto:${email}`} class="block hover:text-gold transition-colors">{email}</a>
      <p>
        {addressLines.map((line) => (
          <>
            {line}<br />
          </>
        ))}
      </p>
    </div>

    <div class="flex gap-4 md:justify-end items-start">
      {social.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.platform}
          class="text-cream/80 hover:text-gold transition-colors"
        >
          {s.platform === 'Facebook' ? (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
          ) : (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          )}
        </a>
      ))}
    </div>
  </div>

  <div class="border-t border-cream/10 py-5 text-center text-xs text-cream/60">
    © {year} par Elevage de Saint Prixe. Lancé et sécurisé par Albin Cousson.
  </div>
</footer>
