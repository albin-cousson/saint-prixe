---
import { urlFor } from '../../lib/sanity/image';

interface Props {
  groomPhoto?: any;
  bridePhoto?: any;
  size?: 'card' | 'hero';
}
const { groomPhoto, bridePhoto, size = 'card' } = Astro.props;

const isHero = size === 'hero';
const photoClass = isHero ? 'w-32 sm:w-40 md:w-48' : 'w-28 sm:w-32 md:w-36';
const ampersandClass = isHero ? 'text-2xl sm:text-3xl' : 'text-xl sm:text-2xl';
const imgWidth = isHero ? 600 : 400;
const imgHeight = isHero ? 450 : 300;
---

<div class="flex items-center justify-center gap-3 sm:gap-4">
  <div class:list={[photoClass, 'shrink-0 aspect-[4/3] overflow-hidden bg-placeholder shadow-[0_8px_20px_rgba(0,0,0,0.16)]']}>
    {groomPhoto && (
      <img src={urlFor(groomPhoto)?.width(imgWidth).height(imgHeight).url()} alt="" class="w-full h-full object-cover" loading="lazy" />
    )}
  </div>
  <span class:list={['shrink-0 font-display italic text-gold-text', ampersandClass]} aria-hidden="true">&amp;</span>
  <div class:list={[photoClass, 'shrink-0 aspect-[4/3] overflow-hidden bg-placeholder shadow-[0_8px_20px_rgba(0,0,0,0.16)]']}>
    {bridePhoto && (
      <img src={urlFor(bridePhoto)?.width(imgWidth).height(imgHeight).url()} alt="" class="w-full h-full object-cover" loading="lazy" />
    )}
  </div>
</div>
