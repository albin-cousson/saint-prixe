---
import Flourish from '../Flourish.astro';
import { urlFor } from '../../lib/sanity/image';
import { isAvailable } from '../../lib/status';

interface Puppy {
  title: string;
  photo?: any;
  status?: string;
}
interface Props {
  slug: string;
  dogGroomName: string;
  dogGroomPhoto?: any;
  dogBrideName: string;
  dogBridePhoto?: any;
  description?: string;
  litterDate?: string;
  puppies: Puppy[];
}

const { slug, dogGroomName, dogGroomPhoto, dogBrideName, dogBridePhoto, description, litterDate, puppies } =
  Astro.props;

const available = puppies.filter((p) => isAvailable(p.status)).length;
const unavailable = puppies.length - available;

function formatDateFr(value?: string) {
  if (!value) return null;
  const d = new Date(value);
  if (isNaN(d.getTime())) return value;
  return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<a href={`/nos-chiots/${slug}`} class="group block bg-white border border-border p-9 pb-7 text-center transition-shadow hover:shadow-[0_12px_24px_rgba(59,59,59,0.1)]">
  <div class="flex items-center justify-center gap-3.5 mb-4.5">
    <div class="w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden border-[3px] border-white shadow-[0_4px_16px_rgba(0,0,0,0.16)] bg-placeholder shrink-0">
      {dogGroomPhoto && (
        <img src={urlFor(dogGroomPhoto)?.width(260).height(260).url()} alt="" class="w-full h-full object-cover" loading="lazy" />
      )}
    </div>
    <div class="w-9 h-9 rounded-full bg-gold text-white flex items-center justify-center font-display text-base shrink-0" aria-hidden="true">
      &amp;
    </div>
    <div class="w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden border-[3px] border-white shadow-[0_4px_16px_rgba(0,0,0,0.16)] bg-placeholder shrink-0">
      {dogBridePhoto && (
        <img src={urlFor(dogBridePhoto)?.width(260).height(260).url()} alt="" class="w-full h-full object-cover" loading="lazy" />
      )}
    </div>
  </div>

  <h3 class="font-display font-bold text-xl md:text-2xl leading-tight mb-1.5">
    {dogGroomName} &amp; {dogBrideName}
  </h3>
  <Flourish class="mx-auto mb-4" />

  {description && <p class="text-sm text-muted leading-relaxed mb-1 line-clamp-2">{description}</p>}

  {puppies.length === 0 ? (
    <p class="text-xs italic text-muted-2 my-4">
      {litterDate ? `Naissance prévue le ${formatDateFr(litterDate)}` : 'Naissance à venir'}
    </p>
  ) : (
    <>
      <div class="flex flex-wrap gap-2 justify-center my-4">
        {puppies.map((p) => {
          const ok = isAvailable(p.status);
          return (
            <div class:list={['relative w-[72px] h-[72px] overflow-hidden bg-placeholder', !ok && 'opacity-90']}>
              {p.photo && (
                <img
                  src={urlFor(p.photo)?.width(150).height(150).url()}
                  alt=""
                  loading="lazy"
                  class:list={['w-full h-full object-cover', !ok && 'grayscale opacity-55']}
                />
              )}
              {!ok && (
                <span class="absolute inset-x-0 bottom-0 bg-black/60 text-white text-[8px] font-bold uppercase tracking-wide text-center py-[3px] px-0.5">
                  {p.status || 'Plus dispo'}
                </span>
              )}
            </div>
          );
        })}
      </div>
      <p class="text-xs text-muted-2 mb-4">
        {available} disponible{available > 1 ? 's' : ''}
        {unavailable > 0 ? ` · ${unavailable} déjà placé${unavailable > 1 ? 's' : ''}` : ''}
      </p>
    </>
  )}

  <span class="block w-full bg-gold group-hover:bg-gold-deep text-white font-semibold text-sm py-3 px-5 transition-colors">
    Découvrir la portée ›
  </span>
</a>
