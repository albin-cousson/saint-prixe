---
import { urlFor } from '../../lib/sanity/image';
import { formatDateFr } from '../../lib/status';

interface Props {
  post: any;
}
const { post } = Astro.props;

const excerptLimit = 110;
const excerpt =
  post.excerpt && post.excerpt.length > excerptLimit
    ? `${post.excerpt.slice(0, excerptLimit).trimEnd()}...`
    : post.excerpt;
---

<a href={`/actualites/${post.slug.current}`} class="group block bg-white border border-border overflow-hidden">
  <div class="aspect-[4/3] overflow-hidden bg-placeholder relative">
    {post.coverImage && (
      <img
        src={urlFor(post.coverImage)?.width(500).height(375).url()}
        alt={post.title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    )}
  </div>
  <div class="p-5">
    <h3 class="font-display font-bold text-base mb-1 text-ink">{post.title}</h3>
    {post.publishedAt && <p class="text-xs text-muted-2 mb-2">{formatDateFr(post.publishedAt)}</p>}
    {excerpt && <p class="text-sm text-muted leading-relaxed">{excerpt}</p>}
  </div>
</a>
