---
import Layout from '../../layouts/Layout.astro';
import MariageCard from '../../components/mariages/MariageCard.astro';
import { sanityClient } from 'sanity:client';
import { MARIAGES_WITH_CHIOTS_QUERY } from '../../lib/sanity/queries';

const mariages = await sanityClient.fetch(MARIAGES_WITH_CHIOTS_QUERY);
---

<Layout title="Nos Chiots" description="Découvrez nos couples et les chiots disponibles à l'élevage De Saint Prixe.">
  <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-7xl mx-auto">
      <h1 class="font-display font-bold text-3xl md:text-4xl text-center mb-3">Nos Chiots</h1>
      <p class="text-center text-muted max-w-2xl mx-auto mb-14">
        Découvrez nos couples et les chiots disponibles, portée par portée.
      </p>

      {mariages.length === 0 ? (
        <p class="text-center text-muted-2 italic py-10">
          Aucun mariage à afficher pour le moment. Revenez bientôt.
        </p>
      ) : (
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {mariages.map((m: any) => (
            <MariageCard
              slug={m.slug?.current}
              dogGroomName={m.dogGroomName}
              dogGroomPhoto={m.dogGroomPhoto}
              dogBrideName={m.dogBrideName}
              dogBridePhoto={m.dogBridePhoto}
              description={m.description}
              litterDate={m.litterDate}
              puppies={m.puppies || []}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
