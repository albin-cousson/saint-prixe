---
import Layout from '../layouts/Layout.astro';
import Flourish from '../components/Flourish.astro';
import DogCard from '../components/dogs/DogCard.astro';
import MariageCard from '../components/mariages/MariageCard.astro';
import { urlFor } from '../lib/sanity/image';
import { formatDateFr } from '../lib/status';
import { sanityClient } from 'sanity:client';
import {
  HOME_PAGE_QUERY,
  BLOG_POSTS_QUERY,
  DOGS_BY_BREED_AND_SEX_QUERY,
  MARIAGES_WITH_CHIOTS_QUERY,
} from '../lib/sanity/queries';

const home = await sanityClient.fetch(HOME_PAGE_QUERY);
const recentPosts = (await sanityClient.fetch(BLOG_POSTS_QUERY)).slice(0, 3);
const males = (await sanityClient.fetch(DOGS_BY_BREED_AND_SEX_QUERY, { breed: 'Bearded Collie', sex: 'Mâle' })).slice(0, 2);
const femelles = (await sanityClient.fetch(DOGS_BY_BREED_AND_SEX_QUERY, { breed: 'Bearded Collie', sex: 'Femelle' })).slice(0, 2);
const mariages = (await sanityClient.fetch(MARIAGES_WITH_CHIOTS_QUERY)).slice(0, 3);
---

<Layout title="Accueil">
  <section class="relative bg-ink text-cream">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 items-center gap-10 py-16 lg:py-0 lg:min-h-[560px]">
      <div class="text-center lg:text-left">
        <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl uppercase leading-[1.05] mb-6">
          {home?.heroHeadline || 'Découvrez notre élevage'}
        </h1>
        {home?.heroSubheadline && (
          <p class="text-lg md:text-xl text-cream/85 mb-8">{home.heroSubheadline}</p>
        )}
        <a
          href={home?.heroButtonHref || '/nos-chiots'}
          class="inline-block bg-gradient-to-br from-[#e8c9a0] to-gold text-ink font-semibold px-7 py-3.5 hover:opacity-90 transition-opacity"
        >
          {home?.heroButtonLabel || 'Nos Portées'} ›
        </a>
      </div>
      {home?.heroImage && (
        <div class="hidden lg:block h-[560px]">
          <img
            src={urlFor(home.heroImage)?.width(900).height(1100).url()}
            alt=""
            class="w-full h-full object-cover"
          />
        </div>
      )}
    </div>
  </section>

  {home?.sections?.[0] && (
    <section class="px-6 lg:px-10 py-16 md:py-20 text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="font-display font-bold text-2xl md:text-3xl mb-3 uppercase">{home.sections[0].heading}</h2>
        <Flourish class="mx-auto mb-6" />
        <p class="text-muted leading-relaxed">
          {home.sections[0].body?.map((b: any) => b.children?.map((c: any) => c.text).join('')).join(' ')}
        </p>
        <a href="/a-propos" class="inline-block mt-6 text-sm font-semibold text-gold-text hover:text-gold-deep transition-colors">
          En savoir plus ›
        </a>
      </div>
    </section>
  )}

  {mariages.length > 0 && (
    <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-center mb-3 uppercase">Nos Chiots</h2>
        <Flourish class="mx-auto mb-12" />
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {mariages.map((m: any) => (
            <MariageCard
              slug={m.slug?.current}
              dogGroomName={m.dogGroomName}
              dogGroomPhoto={m.dogGroomPhoto}
              dogBrideName={m.dogBrideName}
              dogBridePhoto={m.dogBridePhoto}
              description={m.description}
              litterDate={m.litterDate}
              puppies={m.puppies || []}
            />
          ))}
        </div>
        <p class="text-center mt-10">
          <a href="/nos-chiots" class="inline-block bg-gold hover:bg-gold-deep text-white font-semibold px-7 py-3.5 transition-colors">
            Voir toutes nos portées ›
          </a>
        </p>
      </div>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="px-6 lg:px-10 py-16 md:py-20">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-center mb-3 uppercase">Actualités</h2>
        <Flourish class="mx-auto mb-12" />
        <div class="grid gap-8 sm:grid-cols-3">
          {recentPosts.map((p: any) => (
            <a href={`/actualites/${p.slug.current}`} class="group block bg-white border border-border overflow-hidden">
              <div class="aspect-[4/3] overflow-hidden bg-placeholder">
                {p.coverImage && (
                  <img
                    src={urlFor(p.coverImage)?.width(500).height(375).url()}
                    alt=""
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                )}
              </div>
              <div class="p-5">
                <h3 class="font-display font-bold text-base mb-1">{p.title}</h3>
                {p.publishedAt && <p class="text-xs text-muted-2">{formatDateFr(p.publishedAt)}</p>}
              </div>
            </a>
          ))}
        </div>
        <p class="text-center mt-10">
          <a href="/actualites" class="inline-block border border-ink px-6 py-2.5 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
            Toutes les actualités
          </a>
        </p>
      </div>
    </section>
  )}

  {males.length > 0 && (
    <section class="bg-cream px-6 lg:px-10 py-16 md:py-20">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-center mb-3 uppercase">Nos Mâles</h2>
        <Flourish class="mx-auto mb-12" />
        <div class="grid gap-8 sm:grid-cols-2 max-w-3xl mx-auto mb-8">
          {males.map((d: any) => (
            <DogCard name={d.name} photo={d.photo} birthDate={d.birthDate} sire={d.sire} dam={d.dam} titles={d.titles} href={`/nos-chiens/${d.slug?.current}`} />
          ))}
        </div>
        <p class="text-center">
          <a href="/nos-males" class="inline-block border border-ink px-6 py-2.5 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
            Tous les découvrir
          </a>
        </p>
      </div>
    </section>
  )}

  {femelles.length > 0 && (
    <section class="px-6 lg:px-10 py-16 md:py-20">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-display font-bold text-2xl md:text-3xl text-center mb-3 uppercase">Nos Femelles</h2>
        <Flourish class="mx-auto mb-12" />
        <div class="grid gap-8 sm:grid-cols-2 max-w-3xl mx-auto mb-8">
          {femelles.map((d: any) => (
            <DogCard name={d.name} photo={d.photo} birthDate={d.birthDate} sire={d.sire} dam={d.dam} titles={d.titles} href={`/nos-chiens/${d.slug?.current}`} />
          ))}
        </div>
        <p class="text-center">
          <a href="/nos-femelles" class="inline-block border border-ink px-6 py-2.5 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
            Tous les découvrir
          </a>
        </p>
      </div>
    </section>
  )}

  <section class="bg-cream px-6 lg:px-10 py-14 text-center">
    <p class="text-sm text-muted">
      Nous élevons aussi des Shih Tzu —
      <a href="/nos-shih-tzu" class="font-semibold text-gold-text hover:text-gold-deep transition-colors">découvrir nos Shih Tzu ›</a>
    </p>
  </section>
</Layout>
