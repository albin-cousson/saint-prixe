---
import Layout from '../../layouts/Layout.astro';
import { urlFor } from '../../lib/sanity/image';
import { formatDateFr } from '../../lib/status';
import { sanityClient } from 'sanity:client';
import { BLOG_POSTS_QUERY } from '../../lib/sanity/queries';

const posts = await sanityClient.fetch(BLOG_POSTS_QUERY);
---

<Layout title="Actualités" description="Les actualités de l'élevage De Saint Prixe : expositions, résultats, portées.">
  <section class="px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-7xl mx-auto">
      <h1 class="font-display font-bold text-3xl md:text-4xl text-center mb-14">Actualités</h1>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p: any) => (
          <a href={`/actualites/${p.slug.current}`} class="group block bg-white border border-border overflow-hidden">
            {p.coverImage && (
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={urlFor(p.coverImage)?.width(500).height(375).url()}
                  alt=""
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
            )}
            <div class="p-5">
              <h2 class="font-display font-bold text-base mb-1">{p.title}</h2>
              {p.publishedAt && <p class="text-xs text-muted-2">{formatDateFr(p.publishedAt)}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
