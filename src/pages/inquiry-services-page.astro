---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { INQUIRY_PAGE_QUERY } from '../lib/sanity/queries';

const page = await sanityClient.fetch(INQUIRY_PAGE_QUERY);
const email = 'aurelie.cousson68@gmail.com';
const phone = '06 70 91 05 26';
const phoneHref = '0670910526';
---

<Layout title={page?.title || 'Nos services'} description="Explorez nos services et contactez-nous.">
  <section class="px-6 lg:px-10 py-16 md:py-20 text-center">
    <div class="max-w-2xl mx-auto">
      <h1 class="font-display font-bold text-3xl md:text-4xl mb-6">{page?.title || 'Explorez nos services et contactez-nous'}</h1>
      {page?.intro && <p class="text-muted mb-10">{page.intro}</p>}
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`tel:${phoneHref}`} class="border border-ink px-6 py-3 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
          {phone}
        </a>
        <a href={`mailto:${email}`} class="bg-gold hover:bg-gold-deep text-white px-6 py-3 text-sm font-semibold transition-colors">
          {email}
        </a>
      </div>
    </div>
  </section>
</Layout>
