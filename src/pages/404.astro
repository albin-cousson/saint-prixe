---
import Layout from '../layouts/Layout.astro';
import Flourish from '../components/Flourish.astro';
---

<Layout title="Page introuvable" description="Cette page n'existe pas ou plus." noindex>
  <section class="px-6 lg:px-10 py-24 md:py-32 text-center">
    <div class="max-w-lg mx-auto">
      <h1 class="font-display font-bold text-3xl md:text-4xl mb-3">Page introuvable</h1>
      <Flourish class="mx-auto mb-6" />
      <p class="text-muted leading-relaxed mb-8">
        La page que vous cherchez n'existe pas ou plus. Elle a peut-être changé d'adresse.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="inline-block bg-gold hover:brightness-95 text-ink font-semibold px-6 py-3 text-sm transition">
          Retour à l'accueil ›
        </a>
        <a href="/contact" class="inline-block border border-ink px-6 py-3 text-sm font-semibold hover:bg-ink hover:text-cream transition-colors">
          Nous contacter
        </a>
      </div>
    </div>
  </section>
</Layout>
