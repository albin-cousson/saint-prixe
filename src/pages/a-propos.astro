---
import Layout from '../layouts/Layout.astro';
import { PortableText } from 'astro-portabletext';
import { sanityClient } from 'sanity:client';
import { ABOUT_PAGE_QUERY } from '../lib/sanity/queries';

const page = await sanityClient.fetch(ABOUT_PAGE_QUERY);
---

<Layout title="À propos" description="À propos de l'élevage De Saint Prixe.">
  <section class="px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-3xl mx-auto space-y-14">
      {page?.sections?.map((s: any, i: number) => (
        <div class:list={[i === 0 && 'text-center']}>
          {s.heading && (
            <h1 class="font-display font-bold text-2xl md:text-3xl mb-4 uppercase">{s.heading}</h1>
          )}
          <div class="prose-body text-muted leading-relaxed">
            <PortableText value={s.body} />
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
