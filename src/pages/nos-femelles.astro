---
import Layout from '../layouts/Layout.astro';
import DogCard from '../components/dogs/DogCard.astro';
import { sanityClient } from 'sanity:client';
import { DOGS_BY_BREED_AND_SEX_QUERY } from '../lib/sanity/queries';

const dogs = await sanityClient.fetch(DOGS_BY_BREED_AND_SEX_QUERY, { breed: 'Bearded Collie', sex: 'Femelle' });
---

<Layout title="Nos Femelles" description="Les femelles Bearded Collie de l'élevage De Saint Prixe.">
  <section class="px-6 lg:px-10 py-16 md:py-20">
    <div class="max-w-7xl mx-auto">
      <h1 class="font-display font-bold text-3xl md:text-4xl text-center mb-14">Nos Femelles</h1>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {dogs.map((d: any) => (
          <DogCard
            name={d.name}
            photo={d.photo}
            birthDate={d.birthDate}
            sire={d.sire}
            dam={d.dam}
            titles={d.titles}
            href={d.slug?.current ? `/nos-chiens/${d.slug.current}` : undefined}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
